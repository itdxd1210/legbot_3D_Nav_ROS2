#!/usr/bin/python3
"""Compare raw LIO and matched poses; truth is measurement-only.

Optional one-shot seeding uses the mission alignment, not continuous truth feedback.
"""
import json
import math
from collections import deque
import numpy as np
from scipy.spatial.transform import Rotation as R
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data, QoSProfile, DurabilityPolicy
from geometry_msgs.msg import PoseWithCovarianceStamped
from nav_msgs.msg import Odometry
from diagnostic_msgs.msg import DiagnosticArray
from tf2_ros import Buffer, TransformListener


def matrix(p, q):
    t = np.eye(4)
    t[:3, :3] = R.from_quat([q.x, q.y, q.z, q.w]).as_matrix()
    t[:3, 3] = [p.x, p.y, p.z]
    return t


class Comparison(Node):
    def __init__(self):
        super().__init__('localization_comparison')
        with open(self.declare_parameter('map_config', '').value) as f:
            c = json.load(f)['world_from_pct']
        self.world_pct = np.eye(4)
        self.world_pct[:3, :3] = R.from_quat(c[3:]).as_matrix()
        self.world_pct[:3, 3] = c[:3]
        with open(self.declare_parameter('alignment_file', '').value) as f:
            self.world_map = np.asarray(json.load(f)['trials'][0]['world_from_map'])
        self.buffer = Buffer()
        self.listener = TransformListener(self.buffer, self)
        self.data = {k: deque(maxlen=1000) for k in ['raw', 'truth', 'matched']}
        self.world_odom = None
        self.alignment_frame = self.declare_parameter('alignment_frame', 'odom').value
        self.count = 0
        self.record_details = self.declare_parameter('record_details', False).value
        self.match_status = None
        if self.record_details:
            self.create_subscription(DiagnosticArray, '/alignment_status', self.status,
                QoSProfile(depth=100, durability=DurabilityPolicy.TRANSIENT_LOCAL))
        self.total = np.zeros((2, 3))
        self.maximum = np.zeros((2, 3))
        self.seed = self.create_publisher(PoseWithCovarianceStamped, '/initialpose', 10)
        self.seed_initial_pose = self.declare_parameter('seed_initial_pose', True).value
        for key, topic in [('raw', '/fast_lio/odometry_base'), ('truth', '/Odometry_gazebo')]:
            self.create_subscription(Odometry, topic, lambda m, k=key: self.add(k, m), qos_profile_sensor_data)
        self.create_subscription(PoseWithCovarianceStamped, '/pcl_pose', lambda m: self.add('matched', m),
            QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL))
        self.create_timer(0.2, self.process)
        self.create_timer(5.0, self.report)

    def status(self, msg):
        for s in msg.status:
            self.match_status = {
                'stamp': [msg.header.stamp.sec, msg.header.stamp.nanosec],
                'message': s.message,
                'values': {v.key: v.value for v in s.values if v.key in (
                    'fitness_score', 'odom_candidate_review_frames',
                    'odom_candidate_review_span_sec', 'odom_candidate_review_confirmed',
                    'odom_candidate_review_position_spread_m', 'odom_candidate_review_rotation_spread_deg')}}
            if self.record_details:
                self.get_logger().info('MATCH_DIAG ' + json.dumps({
                'stamp': [msg.header.stamp.sec, msg.header.stamp.nanosec],
                'name': s.name, 'level': int.from_bytes(s.level, 'little') if isinstance(s.level, bytes) else int(s.level), 'message': s.message,
                'values': {v.key: v.value for v in s.values}}, separators=(',', ':')))


    def add(self, key, msg):
        if key == 'matched' and msg.header.frame_id != 'localization_probe':
            return
        p = msg.pose.pose
        self.data[key].append((msg.header.stamp.sec + msg.header.stamp.nanosec*1e-9,
                              matrix(p.position, p.orientation), msg.header.stamp))

    def process(self):
        raw, truth, matched = (self.data[k] for k in ['raw', 'truth', 'matched'])
        if not raw:
            return
        if self.world_odom is None:
            if self.seed_initial_pose and not self.seed.get_subscription_count():
                return
            try:
                t = self.buffer.lookup_transform(self.alignment_frame, 'building_pct', rclpy.time.Time()).transform
            except Exception:
                return
            self.world_odom = self.world_pct @ np.linalg.inv(matrix(t.translation, t.rotation))
            initial = np.linalg.inv(self.world_map) @ self.world_odom @ raw[-1][1]
            msg = PoseWithCovarianceStamped()
            msg.header.frame_id = 'localization_probe'
            msg.header.stamp = raw[-1][2]
            p, q = msg.pose.pose.position, msg.pose.pose.orientation
            p.x, p.y, p.z = map(float, initial[:3, 3])
            q.x, q.y, q.z, q.w = map(float, R.from_matrix(initial[:3, :3]).as_quat())
            for i in [0, 7, 14, 21, 28, 35]:
                msg.pose.covariance[i] = 0.01
            if self.seed_initial_pose:
                self.seed.publish(msg)
                self.get_logger().info('One-shot seed from mission alignment; no truth feedback to localization.')
        while matched and truth:
            t, pose, _ = matched[0]
            if t > min(raw[-1][0], truth[-1][0]):
                break
            matched.popleft()
            a = min(raw, key=lambda x: abs(x[0]-t))
            b = min(truth, key=lambda x: abs(x[0]-t))
            if max(abs(a[0]-t), abs(b[0]-t)) > 0.03:
                continue
            errors = []
            for est in [self.world_odom @ a[1], self.world_map @ pose]:
                delta = est[:3, 3] - b[1][:3, 3]
                rot = b[1][:3, :3].T @ est[:3, :3]
                errors.append([np.linalg.norm(delta[:2]), delta[2], math.degrees(math.atan2(rot[1, 0], rot[0, 0]))])
            self.latest = np.asarray(errors)
            if self.record_details:
                self.get_logger().info('MATCH_PAIR ' + json.dumps({
                    'stamp': t, 'raw_stamp': a[0], 'truth_stamp': b[0],
                    'raw_world': (self.world_odom @ a[1]).tolist(),
                    'matched_world': (self.world_map @ pose).tolist(),
                    'truth_world': b[1].tolist(), 'errors': errors}, separators=(',', ':')))
            self.count += 1
            self.total += self.latest**2
            self.maximum = np.maximum(self.maximum, np.abs(self.latest))

    def report(self):
        if not self.count:
            self.get_logger().info('No paired matcher samples yet; this is not a navigation correction state.')
            return
        self.get_logger().info('PAIRED n=%d raw/corrected [XY_m,Z_m,yaw_deg]: current=%s RMSE=%s max=%s' % (
            self.count, np.round(self.latest, 4).tolist(),
            np.round(np.sqrt(self.total/self.count), 4).tolist(), np.round(self.maximum, 4).tolist()))


if __name__ == '__main__':
    rclpy.init()
    node = Comparison()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
