#!/usr/bin/python3
"""Standing-only global localization. Truth and spawn poses are NOT inputs."""
from collections import deque
from concurrent.futures import ThreadPoolExecutor
import json
import math
from pathlib import Path
import sys
import time

import numpy as np
import yaml
from scipy.spatial import cKDTree
from scipy.spatial.transform import Rotation
from ament_index_python.packages import get_package_prefix
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, DurabilityPolicy, qos_profile_sensor_data
from rclpy.executors import ExternalShutdownException
from geometry_msgs.msg import Pose, PoseArray, PoseStamped
from nav_msgs.msg import Odometry
from sensor_msgs.msg import PointCloud2
from sensor_msgs_py import point_cloud2
from std_msgs.msg import Bool, Header, String
from std_srvs.srv import Trigger

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initial_localization_common import (
    pose_matrix, read_xyz_pcd, transform_points, level_scan,
    candidate_matrix, review_candidates, padded_bbs_search, candidate_overlap)
sys.path.insert(0, str(Path(get_package_prefix('lidar_localization_ros2'))/
                      'lib/lidar_localization_ros2'))
from global_localization_query import GlobalLocalizationConfig, GlobalLocalizationEngine
from initial_localization_search import MultiHeightSearch, geometry_cost


def seconds(stamp):
    return stamp.sec + stamp.nanosec*1e-9


def to_pose(matrix):
    result = Pose()
    result.position.x, result.position.y, result.position.z = map(float, matrix[:3, 3])
    q = Rotation.from_matrix(matrix[:3, :3]).as_quat()
    result.orientation.x, result.orientation.y, result.orientation.z, result.orientation.w = map(float, q)
    return result


class Probe(Node):
    def __init__(self):
        super().__init__('initial_localization')
        asset_path = Path(self.declare_parameter('occupancy_yaml', '').value).resolve()
        self.asset = yaml.safe_load(asset_path.read_text())
        source = Path(self.asset['source_map'])
        if source.stat().st_size != self.asset['source_size'] or source.stat().st_mtime_ns != self.asset['source_mtime_ns']:
            raise ValueError('Search assets are stale; source map changed')
        search_map = asset_path.parent/self.asset['search_map']
        target = np.asarray(read_xyz_pcd(search_map)).copy()
        self.tree = cKDTree(target)
        self.map_from_level = np.linalg.inv(np.asarray(self.asset['level_from_map']))
        self.frame = self.asset['map_frame']
        self.height = float(self.asset['base_height_m'])
        self.radius = float(self.asset['scan_range_m'])
        self.engine = GlobalLocalizationEngine(GlobalLocalizationConfig(
            z_min_m=.50-self.height, z_max_m=2.50-self.height,
            max_scan_points=512, angular_resolution_rad=math.radians(5),
            max_candidates=24, pyramid_depth=5, nms_radius_m=1.,
            seed_z_m=self.height, registration_seed_z_m=self.height,
            use_cpp_backend=True, enable_registration_scoring=True,
            registration_refine_candidates=True, map_path=str(search_map),
            ndt_resolution=.5, ndt_scan_voxel_leaf_size=.2,
            ndt_target_voxel_leaf_size=.2, ndt_num_threads=1,
            ndt_max_iterations=40, ndt_local_map_radius=25.), occupancy_yaml=asset_path)
        # Do not silently replace NDT review with a BBS-only result or run the
        # much slower Python map-wide search on a 16 GB desktop.
        if self.engine.backend != 'cpp' or self.engine.registration_scorer is None:
            raise RuntimeError('Compiled BBS/NDT required: ' + str(
                (self.engine.backend_error, self.engine.registration_scoring_error)))
        self.engine._search = padded_bbs_search(self.engine._search)
        self.search = MultiHeightSearch(self.engine, target, self.tree, self.height)
        latched = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.result_pub = self.create_publisher(String, '~/result', latched)
        self.pose_pub = self.create_publisher(PoseStamped, '~/best_pose', latched)
        self.candidates_pub = self.create_publisher(PoseArray, '~/candidates', latched)
        self.map_pub = self.create_publisher(PointCloud2, '~/map', latched)
        self.status_pub = self.create_publisher(String, '~/status', latched)
        # Same reduced map, shown back in its original PCD coordinate system.
        self.map_pub.publish(point_cloud2.create_cloud_xyz32(
            Header(frame_id=self.frame), transform_points(target, self.map_from_level).astype(np.float32)))
        self.odometry = deque(maxlen=500)
        self.latest_cloud = None
        self.ready_time = None
        self.future = None
        self.auto_started = False
        self.progress = None
        self.last_progress = None
        self.pool = ThreadPoolExecutor(max_workers=1)
        self.create_subscription(Odometry, '/fast_lio/odometry_base', self.on_odom, qos_profile_sensor_data)
        self.create_subscription(PointCloud2, '/fast_lio/cloud_registered', self.on_cloud, qos_profile_sensor_data)
        self.create_subscription(Bool, '/go2/demo_ready', self.on_ready, latched)
        self.create_service(Trigger, '~/query', self.on_query)
        self.create_timer(.25, self.tick)
        self.get_logger().info('READY: map-derived height hypotheses %s; no truth seed, no navigation output' % self.search.heights)

    def on_odom(self, msg):
        if msg.header.frame_id != 'odom' or msg.child_frame_id != 'base':
            return
        matrix = pose_matrix(msg.pose.pose)
        if np.isfinite(matrix).all():
            self.odometry.append((seconds(msg.header.stamp), matrix))

    def on_cloud(self, msg):
        if msg.header.frame_id == 'odom':
            self.latest_cloud = msg

    def on_ready(self, msg):
        if msg.data and self.ready_time is None:
            self.ready_time = self.get_clock().now().nanoseconds*1e-9

    def on_query(self, request, response):
        response.success, response.message = self.start_query()
        return response

    def start_query(self):
        if self.future is not None:
            return False, 'Search already running'
        if self.ready_time is None or not self.odometry or self.latest_cloud is None:
            return False, 'Waiting for stable standing and FAST-LIO scans'
        cloud = self.latest_cloud
        stamp = seconds(cloud.header.stamp)
        now = self.get_clock().now().nanoseconds*1e-9
        odom_time, matrix = min(self.odometry, key=lambda item: abs(item[0]-stamp))
        if abs(odom_time-stamp) > .05 or not 0 <= now-stamp < 1.:
            return False, 'No fresh synchronized cloud and base odometry'
        points = point_cloud2.read_points_numpy(cloud, field_names=('x', 'y', 'z'), skip_nans=True).reshape(-1, 3)
        points, level_from_base = level_scan(points, matrix)
        ranges = np.linalg.norm(points, axis=1)
        points = points[(ranges > 1.) & (ranges < self.radius)]
        _, indices = np.unique(np.floor(points/.15).astype(np.int64), axis=0, return_index=True)
        points = points[indices]
        if len(points) > 30000:
            points = points[np.linspace(0, len(points)-1, 30000).astype(int)]
        if len(points) < 300:
            return False, 'Too few scan points for a global search'
        self.snapshot = (cloud.header.stamp, matrix, level_from_base, points)
        self.progress = ('started', 0, 0)
        self.started = time.monotonic()
        self.future = self.pool.submit(self.search.query, points, progress_callback=self.on_progress)
        self.get_logger().info('SEARCH started: %d scan points, range %.1fm; remain standing' % (len(points), self.radius))
        return True, 'Search queued; see /initial_localization/result and /initial_localization_truth/result'

    def on_progress(self, phase, done, total):
        self.progress = (phase, done, total)

    def tick(self):
        now = self.get_clock().now().nanoseconds*1e-9
        if self.ready_time is not None and now-self.ready_time >= 3 and not self.auto_started:
            ok, _ = self.start_query()
            self.auto_started = ok
        if self.future is None:
            return
        if self.progress != self.last_progress:
            self.status_pub.publish(String(data=json.dumps({'phase': self.progress,
                'elapsed_wall_s': round(time.monotonic()-self.started, 2)})))
            self.last_progress = self.progress
        if not self.future.done():
            return
        future, self.future = self.future, None
        stamp, odom, level_from_base, points = self.snapshot
        try:
            result = future.result()
            best, decision, reviews = review_candidates(result.candidates, points, self.tree,
                                                       self.height, self.search.heights)
            motion = np.linalg.inv(odom) @ self.odometry[-1][1]
            if np.linalg.norm(motion[:3, 3]) > .10 or Rotation.from_matrix(motion[:3, :3]).magnitude() > math.radians(5):
                decision = 'robot_moved_during_search'
            matrices = [self.map_from_level @ candidate_matrix(c) @ level_from_base for c in result.candidates]
            header = Header(stamp=stamp, frame_id=self.frame)
            self.candidates_pub.publish(PoseArray(header=header, poses=[to_pose(m) for m in matrices]))
            review_details = []
            for c, ratio, rmse in reviews:
                _, _, sr, se, count = candidate_overlap(c, points, self.tree, self.height)
                review_details.append({'xyz': [c.x_m, c.y_m, c.z_m], 'yaw_deg': math.degrees(c.yaw_rad),
                    'geometry_cost_m2': geometry_cost(c, points, self.tree),
                    'bbs_score': c.bbs_score, 'ndt_fitness': c.registration_fitness,
                    'overlap_030m': ratio, 'inlier_rmse_m': rmse,
                    'structure_overlap_030m': sr, 'structure_inlier_rmse_m': se,
                    'structure_point_count': count})
            message = {'decision': decision, 'stamp_s': seconds(stamp), 'frame': self.frame,
                'runtime_wall_s': round(time.monotonic()-self.started, 3), 'scan_points': len(points),
                'truth_input': False, 'navigation_output': False, 'candidate_count': len(matrices),
                'reviews': review_details, 'height_hypotheses_m': self.search.heights,
                'query_stats': self.search.last_query_stats,
                'result_age_s': self.get_clock().now().nanoseconds*1e-9-seconds(stamp),
                'registration_backend': result.registration_scoring_backend}
            if best is not None:
                best_matrix = self.map_from_level @ candidate_matrix(best) @ level_from_base
                message['map_from_base'] = best_matrix.tolist()
                self.pose_pub.publish(PoseStamped(header=header, pose=to_pose(best_matrix)))
            self.result_pub.publish(String(data=json.dumps(message)))
            self.get_logger().info('SEARCH finished: %s; %d candidates, %.2fs; truth observer reports error separately' % (
                decision, len(matrices), time.monotonic()-self.started))
        except Exception as exc:
            self.get_logger().error('Search failed: ' + str(exc))
            self.result_pub.publish(String(data=json.dumps({'decision': 'search_error', 'error': str(exc)})))


def main():
    rclpy.init()
    node = Probe()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.pool.shutdown(wait=False, cancel_futures=True)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
